          "legendFormat": "persisted to Redpanda",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "2 — Events persisted to Redpanda",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "A/C metric 3. Records the consumer poll loop pulled out of the topic. Delivery is at-least-once and a failed commit replays the whole poll, so this counts records handled, not distinct events.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "events/sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
