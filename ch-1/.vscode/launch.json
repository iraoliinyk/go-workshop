{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Run Wiki Stream Consumer",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      // Debugger limitation: dlv can only attach to one package at a time.
      // To run ALL tests use the task: Ctrl+Shift+P → "Tasks: Run Test Task"
      "name": "Debug Tests (current package)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}",
      "args": ["-v", "-race"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Test at Cursor",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}",
      "args": ["-v", "-run", "${selectedText}"],
      "console": "integratedTerminal"
    }
  ]
}
